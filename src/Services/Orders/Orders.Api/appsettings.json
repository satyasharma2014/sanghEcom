      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrdersDb": "Host=localhost;Port=5437;Database=orders_db;Username=orders;Password=orders1234"
